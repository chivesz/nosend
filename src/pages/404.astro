---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page not found | nosend.io"
  description="This page doesn't exist. Head back to nosend.io to compress images without uploading them."
  noindex
>
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 sm:px-6 py-24 text-center">
    <p class="text-sm font-semibold text-indigo-600 mb-3">404</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Page not found</h1>
    <p class="text-slate-600 mb-10">This page doesn't exist or has moved.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="inline-flex justify-center items-center px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition-colors">
        Compress images
      </a>
      <a href="/blog/" class="inline-flex justify-center items-center px-5 py-2.5 rounded-lg border border-slate-200 text-slate-700 font-medium hover:bg-slate-50 transition-colors">
        Read the blog
      </a>
    </div>
  </main>
  <Footer />
</Layout>
